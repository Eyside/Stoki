rules_version = '2';

// ============================================================================
// STOKI - Règles de sécurité Firestore (NIVEAU 2)
//
//  - Un compte n'est lisible que par son propriétaire (plus d'e-mails exposés).
//  - Un groupe n'est lisible que par ses membres ; on le rejoint grâce à une
//    fiche d'invitation invites/{code}, lisible seulement si on connaît le code.
//  - Une recette n'est lisible que par son propriétaire ou, pour une recette de
//    groupe, par les membres de ce groupe.
//
// À coller dans : console Firebase > Firestore Database > Règles > Publier,
// APRÈS avoir installé la version de l'application de l'étape 5.
// Gardez une copie de vos anciennes règles avant de publier.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // Fonctions utilitaires
    // ------------------------------------------------------------------------
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Je suis membre du groupe
    function isMember(groupId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Je suis administrateur du groupe
    function isGroupAdmin(groupId) {
      return isMember(groupId) &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Je peux modifier cette recette (propriétaire, ou recette de groupe dont je suis membre)
    function canEditRecette(recetteId) {
      let r = get(/databases/$(database)/documents/recettes/$(recetteId)).data;
      return r.ownerId == request.auth.uid ||
        (r.visibility == 'group' && r.groupId != null && isMember(r.groupId));
    }

    // Je peux lire cette recette (propriétaire, ou recette de groupe dont je suis membre)
    function canReadRecette(recetteId) {
      let r = get(/databases/$(database)/documents/recettes/$(recetteId)).data;
      return r.ownerId == request.auth.uid ||
        (r.visibility == 'group' && r.groupId != null && isMember(r.groupId));
    }

    // ------------------------------------------------------------------------
    // Utilisateurs
    // Mon compte : visible par moi seul (les autres membres d'un groupe ne
    // voient que mon nom et mon coefficient, copiés dans le groupe).
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isUser(userId);
      allow write: if isUser(userId);

      // Mon profil complet (âge, poids, taille...) : visible par moi seul
      match /private/{docId} {
        allow read, write: if isUser(userId);
      }

      // Mon suivi calorique : visible par moi seul
      match /calorie_tracking/{entryId} {
        allow read, write: if isUser(userId);
      }
    }

    // ------------------------------------------------------------------------
    // Groupes
    // Lisibles par leurs membres seulement.
    // ------------------------------------------------------------------------
    match /groups/{groupId} {
      allow read: if isMember(groupId);

      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid;

      // Un administrateur modifie tout ; un membre peut seulement ajuster le
      // compteur de membres (rejoindre / quitter).
      allow update: if isGroupAdmin(groupId) ||
        (isMember(groupId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));

      allow delete: if isGroupAdmin(groupId);

      // ----- Membres du groupe -----
      match /members/{memberId} {
        // Je peux lire ma propre fiche (pour savoir si je suis déjà membre)
        allow get: if isUser(memberId) || isMember(groupId);
        allow list: if isMember(groupId);

        // Je m'ajoute moi-même, en prouvant que je connais le code d'invitation
        // actuel ; administrateur seulement si j'ai créé le groupe.
        allow create: if isUser(memberId) &&
          request.resource.data.userId == request.auth.uid &&
          ((request.resource.data.role == 'member' &&
            request.resource.data.inviteCode ==
              get(/databases/$(database)/documents/groups/$(groupId)).data.inviteCode) ||
           (request.resource.data.role == 'admin' &&
            get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid));

        // Transfert des droits d'administrateur ; chacun peut mettre à jour
        // son propre nom affiché.
        allow update: if isGroupAdmin(groupId) ||
          (isUser(memberId) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']));

        // Je me retire moi-même, ou un administrateur retire un membre
        allow delete: if isUser(memberId) || isGroupAdmin(groupId);
      }

      // ----- Profils de groupe : nom + coefficient de mangeur uniquement -----
      // Un document par membre, dont l'identifiant est son uid.
      // Visibles uniquement par les membres du groupe.
      match /profiles/{profileId} {
        allow read: if isMember(groupId);

        allow create: if isMember(groupId) &&
          profileId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;

        allow update: if isMember(groupId) &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid;

        // Je peux toujours supprimer mes propres profils, même après avoir quitté le groupe
        allow delete: if signedIn() && resource.data.userId == request.auth.uid;
      }
    }

    // ------------------------------------------------------------------------
    // Invitations : invites/{code}. Lecture d'une fiche seulement si on connaît
    // son code (pas de liste) ; création et suppression par l'administrateur.
    // ------------------------------------------------------------------------
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn() &&
        isGroupAdmin(request.resource.data.groupId) &&
        get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;

      allow delete: if signedIn() && isGroupAdmin(resource.data.groupId);
    }

    // Requête « mes groupes » : collectionGroup('members').where('userId', '==', uid)
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------------------------
    // Ingrédients
    // ------------------------------------------------------------------------
    match /ingredients/{ingredientId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'public' ||
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.visibility == 'private' ||
         request.resource.data.visibility == 'public' ||
         (request.resource.data.visibility == 'group' &&
          request.resource.data.groupId != null &&
          isMember(request.resource.data.groupId)));

      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      ) && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ------------------------------------------------------------------------
    // Recettes
    // Un repas de groupe utilise toujours une recette de la banque du groupe
    // (l'application en crée une copie si besoin).
    // ------------------------------------------------------------------------
    match /recettes/{recetteId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.visibility != 'group' ||
         (request.resource.data.groupId != null && isMember(request.resource.data.groupId)));

      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Ingrédients de la recette : mêmes droits que la recette
      match /ingredients/{ingredientId} {
        allow read: if signedIn() && canReadRecette(recetteId);
        allow write: if signedIn() && canEditRecette(recetteId);
      }
    }

    // ------------------------------------------------------------------------
    // Planning
    // ------------------------------------------------------------------------
    match /planning/{planningId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.visibility == 'private' ||
         (request.resource.data.visibility == 'group' &&
          request.resource.data.groupId != null &&
          isMember(request.resource.data.groupId)));

      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      ) && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );
    }

    // ------------------------------------------------------------------------
    // Stock (frigo)
    // ------------------------------------------------------------------------
    match /frigo/{frigoId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.visibility == 'private' ||
         (request.resource.data.visibility == 'group' &&
          request.resource.data.groupId != null &&
          isMember(request.resource.data.groupId)));

      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      ) && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );
    }

    // ------------------------------------------------------------------------
    // Liste de courses
    // ------------------------------------------------------------------------
    match /shopping_list/{itemId} {
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );

      allow create: if signedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        (request.resource.data.visibility == 'private' ||
         (request.resource.data.visibility == 'group' &&
          request.resource.data.groupId != null &&
          isMember(request.resource.data.groupId)));

      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      ) && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        (resource.data.visibility == 'group' &&
         resource.data.groupId != null &&
         isMember(resource.data.groupId))
      );
    }
  }
}
